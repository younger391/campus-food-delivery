<view class="container"><view wx:for="{{orders}}" wx:key="id" class="card"><view class="row"><text>订单 {{item.id}}</text><text class="tag">{{item.status}}</text></view><view>{{item.customer}}</view><view class="muted">{{item.items}}</view><view class="row"><text class="price">¥{{item.total}}</text><view wx:if="{{item.status==='待接单'}}"><button size="mini" data-status="已拒单" bindtap="action">拒单</button><button size="mini" class="accept" data-status="已接单" bindtap="action">接单</button></view></view></view></view>
