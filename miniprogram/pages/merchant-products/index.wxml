<view class="container"><view class="actions"><button size="mini" bindtap="goOrders">订单管理</button><button size="mini" bindtap="goSettings">营业设置</button></view><view class="section-title">食光简餐 · 商品管理</view><view wx:for="{{products}}" wx:key="id" class="card row"><text class="icon">{{item.image}}</text><view class="grow"><view>{{item.name}}</view><view class="price">¥{{item.price}}</view></view><switch checked="{{item.status !== false}}" data-id="{{item.id}}" bindchange="toggle" color="#ff6b35"/></view></view>
