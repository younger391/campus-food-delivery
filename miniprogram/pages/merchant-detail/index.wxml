<view class="container" wx:if="{{merchant}}"><view class="header"><text class="icon">{{merchant.image}}</text><view><view class="name">{{merchant.name}}</view><view>{{merchant.score}}分 · 起送¥{{merchant.minOrder}} · 配送¥{{merchant.deliveryFee}}</view><view class="notice">{{merchant.notice}}</view></view></view><view class="section-title">商品</view><view wx:for="{{merchant.products}}" wx:key="id" class="card product"><text class="picon" data-id="{{item.id}}" bindtap="product">{{item.image}}</text><view class="grow" data-id="{{item.id}}" bindtap="product"><view class="pname">{{item.name}}</view><view class="muted">{{item.description}}</view><view class="price">¥{{item.price}} <text class="muted">月售{{item.sold}}</text></view></view><button class="add" size="mini" data-id="{{item.id}}" bindtap="add">+</button></view></view>
