<view class="container" wx:if="{{order}}"><view class="card"><view class="section-title">{{order.status}}</view><view class="muted">这是模拟订单，商家接单后将显示进度。</view></view><view class="card"><view>配送地址：{{order.address.detail}}</view><view class="muted">{{order.address.name}} {{order.address.phone}}</view></view><view class="card"><view wx:for="{{order.items}}" wx:key="name" class="row"><text>{{item.name}} × {{item.count}}</text><text>¥{{item.price * item.count}}</text></view><view class="row"><text>订单金额</text><text class="price">¥{{order.total}}</text></view></view><view class="card muted">订单号：{{order.id}}<br/>下单时间：{{order.time}}</view></view>
