<view class="container"><view class="card" bindtap="addresses"><view class="row"><view><view>{{address.name}} {{address.phone}}</view><view class="muted">{{address.detail}}</view></view><text>›</text></view></view><view class="card"><view wx:for="{{items}}" wx:key="id" class="row"><text>{{item.name}} × {{item.count}}</text><text>¥{{item.price * item.count}}</text></view><view class="row total"><text>合计</text><text class="price">¥{{total}}</text></view></view><view class="tip">模拟订单，不会触发真实支付或配送。</view><button class="primary submit" bindtap="submit">提交订单</button></view>
