<view class="container"><view wx:if="{{!items.length}}" class="empty">购物车还是空的，去挑选喜欢的美食吧</view><view wx:else><view wx:for="{{items}}" wx:key="id" class="card row"><text class="icon">{{item.image}}</text><view class="grow"><view>{{item.name}}</view><view class="price">¥{{item.price}}</view></view><view class="counter"><text data-id="{{item.id}}" data-delta="-1" bindtap="change">−</text><text>{{item.count}}</text><text data-id="{{item.id}}" data-delta="1" bindtap="change">+</text></view></view><view class="bar">合计 <text class="price">¥{{total}}</text><button class="primary" bindtap="checkout">去结算</button></view></view></view>
