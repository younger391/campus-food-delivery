<view class="container"><view class="hero"><text class="hero-title">{{campus}} · 校园外卖</text><text>好好吃饭，准时送到宿舍楼下</text></view><view class="section-title">热门分类</view><view class="categories"><view wx:for="{{categories.slice(1)}}" wx:key="*this" class="category" bindtap="goMerchants">{{item}}</view></view><view class="row"><view class="section-title">附近好店</view><text class="more" bindtap="goMerchants">查看全部 ›</text></view><view wx:for="{{merchants}}" wx:key="id" class="card merchant" bindtap="goMerchant" data-id="{{item.id}}"><text class="food-icon">{{item.image}}</text><view><view class="name">{{item.name}} <text wx:if="!item.business" class="closed">休息中</text></view><view class="muted">{{item.score}}分 · 起送¥{{item.minOrder}} · 配送¥{{item.deliveryFee}}</view><view class="muted">{{item.notice}}</view></view></view></view>
