<view class="container"><scroll-view scroll-x class="tabs"><text wx:for="{{categories}}" wx:key="*this" class="tab {{active===item?'active':''}}" data-name="{{item}}" bindtap="choose">{{item}}</text></scroll-view><view wx:for="{{list}}" wx:key="id" class="card merchant" data-id="{{item.id}}" bindtap="detail"><text class="icon">{{item.image}}</text><view><view class="title">{{item.name}} <text wx:if="!item.business" class="closed">已打烊</text></view><view class="muted">{{item.category}} · {{item.score}}分</view><view class="muted">起送¥{{item.minOrder}} · 配送¥{{item.deliveryFee}}</view><text class="tag">{{item.notice}}</text></view></view></view>
