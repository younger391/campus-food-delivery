<view class="container"><view wx:if="{{!orders.length}}" class="empty">暂无订单</view><view wx:for="{{orders}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="detail"><view class="row"><text>校园外卖订单</text><text class="tag">{{item.status}}</text></view><view wx:for="{{item.items}}" wx:key="name" class="muted">{{item.name}} × {{item.count}}</view><view class="row"><text class="muted">{{item.time}}</text><text>实付 <text class="price">¥{{item.total}}</text> ›</text></view></view></view>
